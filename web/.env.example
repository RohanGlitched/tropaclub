# --- data (Phase 1) ---
# live (default, falls back to sample data per file) or mock
DATA_SOURCE=live
DATA_BASE_URL=https://storage.googleapis.com/tropaclub-data/public
# Public origin used in share links, invites and metadata
SITE_URL=https://tropaclub.xyz
# Share pictures: bucket + prefix. The service account needs objectAdmin on the prefix.
CARDS_BUCKET=tropaclub-data
CARDS_PREFIX=public/cards
# 1 = never touch GCS, write to web/.cards (local dev)
CARDS_LOCAL=0

# --- region gate ---
# off = never hide buying by country
REGION_GATE=on
# DB-IP Country Lite database. Default: ../geo/dbip-country-lite.mmdb relative to the server's working directory
# GEO_DB_PATH=

# --- wallet sign-in (Phase 2) ---
# Signs the challenge and the __session cookie. Required in production (Secret Manager).
SESSION_SECRET=

# --- clubs engine (Phase 2) ---
# firestore | memory. Default: firestore on Cloud Run or with FIRESTORE_EMULATOR_HOST, else memory with sample clubs.
# CLUBS_STORE=
# Fixed clock for the sample clubs (memory store only)
# CLUBS_DEMO_NOW=2026-11-25T20:00:00Z
GOOGLE_CLOUD_PROJECT=project-5523359e-5941-4df4-998
# HMAC salt for pick-up matching. Required in production (Secret Manager).
PICKUP_MATCH_SALT=
# Optional keyed Base RPC, tried before the public ones
# BASE_RPC_URL=
# Optional: faster wallet history for statements
# ETHERSCAN_API_KEY=

# --- scheduled jobs ---
# Cloud Scheduler sends this in the x-cron-secret header to POST /api/cron/<job>
CRON_SECRET=
