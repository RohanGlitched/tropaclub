{
  "name": "@tropaclub/clubs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tropa Club clubs engine: clubs, seats, verified buys, gameweeks, fixtures, streaks, call-ups, stats, cohorts, EAS pennants and the cost-basis statement. Server-only (Firestore Admin SDK).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-tropaclub \"vitest run\"",
    "seed:demo": "firebase emulators:exec --only firestore --project demo-tropaclub \"tsx scripts/seed-demo.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tropaclub/buy": "file:../buy",
    "firebase-admin": "13.10.0",
    "viem": "2.58.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "firebase-tools": "13.29.1",
    "tsx": "4.19.2",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  },
  "overrides": {
    "universal-analytics": {
      "uuid": "8.3.2"
    }
  }
}
